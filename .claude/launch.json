{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sylph",
      "runtimeExecutable": "env",
      "runtimeArgs": ["-u", "PORT", "npm", "run", "dev"],
      "port": 5173
    },
    {
      "name": "sylph-alt-ports",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3013",
        "npx",
        "concurrently",
        "vite --port $PORT --strictPort",
        "env PORT=3013 tsx server/index.ts"
      ],
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "sylph-alt-ports-2",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3031",
        "npx",
        "concurrently",
        "vite --port $PORT --strictPort",
        "env PORT=3031 tsx server/index.ts"
      ],
      "port": 5299,
      "autoPort": true
    }
  ]
}
